{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=Mango_AuthAPI;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "ApiSettings": {
    "JwtOptions": {
      "Secret": "YOUR_STRONG_JWT_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS",
      "Issuer": "mango-auth-api",
      "Audience": "mango-client"
    }
  },
  "TopicAndQueueNames": {
    "RegisterUserQueue": "registeruser",
    "ServiceBusConnectionString": "REPLACE_WITH_YOUR_AZURE_SERVICE_BUS_CONNECTION_STRING"
  }
}

