@model IEnumerable<ProductDto>

<form method="post">
    <div class="container row">
        @foreach (var product in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 pb-4">
                <div class="p-0 my-3 border rounded shadow-sm h-100 d-flex flex-column bg-white">
                    <div class="position-relative">
                        <img src="@product.ImageUrl" class="card-img-top rounded-top" style="width: 100%; height: 250px; object-fit: cover;" alt="@product.Name" />
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">@product.CategoryName</span>
                    </div>
                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title text-success mb-0">@product.Name</h5>
                            <span class="text-danger fw-bold fs-5">@((product.Price).ToString("c"))</span>
                        </div>
                        <div class="card-text text-muted mb-3 flex-grow-1" style="font-size: 14px;">
                            @Html.Raw(product.Description)
                        </div>
                        <div class="mt-auto">
                            <a asp-action="ProductDetails" asp-route-productId="@product.ProductId" class="btn btn-success form-control">Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</form>
