@model CartDto

@if (Model.CartHeader != null && Model.CartDetails != null && Model.CartDetails.Count() > 0)
{
    <form method="post">
        <br />
        <input asp-for="CartHeader.UserId" hidden />
        <input asp-for="CartHeader.CartHeaderId" hidden />
        <div class="card shadow border-0 mt-4 container">
            <div class="card-header bg-dark bg-gradient text-light ml-0 py-3 row">
                <div class="col-6">
                    <h3 class="text-white"><i class="bi bi-cart"></i> &nbsp; Shopping Cart</h3>
                </div>
                <div class="col-6 text-end">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-warning btn-sm text-uppercase">Continue Shopping</a>
                </div>
            </div>
            <div class="card-body">
                <div class="d-none d-lg-block">
                    <div class="row text-info">
                        <div class="col-lg-2"></div>
                        <div class="col-lg-5">Product Details</div>
                        <div class="col-lg-2">Price</div>
                        <div class="col-lg-2">Count</div>
                        <div class="col-lg-1"></div>
                    </div>
                </div>
                <hr />

                @foreach (var cartObj in Model.CartDetails)
                {
                    <div class="row h-100 align-items-center mb-3">
                        <div class="col-4 col-md-2 text-center py-2">
                            <img src="@cartObj.Product?.ImageUrl" class="rounded" width="100%" alt="@cartObj.Product?.Name" />
                        </div>
                        <div class="col-8 col-md-5">
                            <h5>@cartObj.Product?.Name</h5>
                            <div style="font-size:11px;">@Html.Raw(cartObj.Product?.Description)</div>
                        </div>
                        <div class="col-3 col-md-2 pt-md-4" style="font-size:11px;">
                            <span style="font-size:17px;">@((cartObj.Product?.Price ?? 0).ToString("c"))</span>
                        </div>
                        <div class="col-3 col-md-2 pt-md-4" style="font-size:11px;">
                            <span style="font-size:17px;">@cartObj.Count</span>
                        </div>
                        <div class="col-2 col-md-1 p-0 pt-md-4 text-end">
                            <a asp-action="Remove" asp-route-cartDetailsId="@cartObj.CartDetailsId" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </div>
                    </div>
                    <hr />
                }

                <div class="row">
                    <div class="col-6">
                        <span>Coupon:</span>
                        @if (string.IsNullOrEmpty(Model.CartHeader.CouponCode))
                        {
                            <input asp-for="CartHeader.CouponCode" class="form-control" />
                            <button type="submit" asp-action="ApplyCoupon" class="btn btn-sm btn-success mt-2">Apply</button>
                        }
                        else
                        {
                            <input asp-for="CartHeader.CouponCode" disabled class="form-control" />
                            <button type="submit" asp-action="RemoveCoupon" class="btn btn-sm btn-danger mt-2">Remove</button>
                        }
                    </div>
                    <div class="col-6 text-end">
                        <span class="text-danger" style="font-size:21px;">
                            Order Total : @Model.CartHeader.CartTotal.ToString("c") <br />
                        </span>
                        @if (Model.CartHeader.Discount > 0)
                        {
                            <span class="text-success">
                                Order Discount : @Model.CartHeader.Discount.ToString("c")
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="card-footer row">
                <div class="col-6 col-md-3">
                    <button type="submit" asp-action="EmailCart" class="btn btn-outline-danger form-control">Email Cart</button>
                </div>
                <div class="col-6 col-md-3 offset-md-6">
                    <a asp-action="Checkout" class="btn btn-success form-control">Looks Good</a>
                </div>
            </div>
        </div>
    </form>
}
else
{
    <div class="container text-center pt-5">
        <p class="lead">Please add items to cart.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Browse Products</a>
    </div>
}
